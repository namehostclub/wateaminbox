{
	email {$ACME_EMAIL}
	admin 0.0.0.0:2019
	servers {
		protocols h1 h2
	}
}

(common_security) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$APP_DOMAIN} {
	import common_security

	handle /api/* {
		reverse_proxy api-router:4451 {
			# Replace, rather than append to, any edge-provided chain. HAProxy
			# appends this Caddy hop before the API consumes the first address.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Mobile app direct download routing
	handle /downloads/* {
		redir /api{uri} 302
	}

	# OAuth discovery. RFC 8414 and RFC 9728 fix these paths at the root, so
	# they cannot be served under /api. Without this rule they fall through to
	# the SPA below and answer 200 with HTML, which an MCP client reads as a
	# malformed document rather than a missing one.
	handle /.well-known/oauth-* {
		reverse_proxy api-router:4451 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /connection/* {
		reverse_proxy centrifugo:8000
	}

	handle /whatsapp-media/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy web:8080
	}
}
